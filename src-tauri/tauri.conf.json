{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rayrag Companion",
  "version": "0.1.0",
  "identifier": "com.rayrag.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Rayrag Companion", "width": 1100, "height": 880, "minWidth": 820, "minHeight": 750 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["controller", "game-telemetry"]
    }
  },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/icon.png"], "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" } }
}
