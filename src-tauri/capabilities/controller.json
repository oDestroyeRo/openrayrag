{
  "identifier": "controller",
  "description": "The bundled controller can open the fixed game URL and start or stop its bot.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-open-game",
    "allow-close-game",
    "allow-control-bot",
    "allow-login-game",
    "allow-reconnect-game",
    "allow-saved-login",
    "allow-forget-login",
    "allow-update-status",
    "allow-update-open-release",
    "allow-current-form",
    "allow-save-current-form",
    "allow-update-initialized",
    "allow-update-reserve",
    "allow-update-release",
    "allow-update-install"
  ]
}
